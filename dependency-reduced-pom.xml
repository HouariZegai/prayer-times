<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.houarizegai</groupId>
  <artifactId>PrayerTimes</artifactId>
  <version>1.0.0</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>com.houarizegai.prayertimes.App</mainClass>
                </transformer>
              </transformers>
              <finalName>PrayerTimes-${project.version}</finalName>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.houarizegai.prayertimes.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <unirest-java.version>3.14.5</unirest-java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <json.version>20251224</json.version>
    <lombok.version>1.18.42</lombok.version>
    <maven.compiler.target>21</maven.compiler.target>
    <jfoenix.version>9.0.10</jfoenix.version>
    <ikonli.version>12.4.0</ikonli.version>
    <openjfx.version>21.0.2</openjfx.version>
  </properties>
</project>
